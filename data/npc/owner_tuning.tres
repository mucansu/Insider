[gd_resource type="Resource" script_class="OwnerTuning" format=3]

[ext_resource type="Script" path="res://data/npc/owner_tuning.gd" id="1_otune"]
[ext_resource type="Script" path="res://entities/npc/components/agenda_task.gd" id="2_task"]

[sub_resource type="Resource" id="Resource_counter"]
script = ExtResource("2_task")
name = &"counter"
marker = &"ClerkSpot"
min_sec = 25.0
max_sec = 40.0
facing = Vector2(-1, 0)
home = true

[sub_resource type="Resource" id="Resource_restock"]
script = ExtResource("2_task")
name = &"restock"
marker = &"RestockSpot"
min_sec = 6.0
max_sec = 10.0
facing = Vector2(0, -1)
noise_kind = &"shelf"
noise_interval_sec = 2.0

[sub_resource type="Resource" id="Resource_backroom"]
script = ExtResource("2_task")
name = &"backroom"
marker = &"BackroomSpot"
min_sec = 10.0
max_sec = 15.0
facing = Vector2(0, 1)

[sub_resource type="Resource" id="Resource_phone"]
script = ExtResource("2_task")
name = &"phone"
marker = &"PhoneSpot"
min_sec = 10.0
max_sec = 15.0
facing = Vector2(1, 0)
half_angle_deg = 25.0
bell_interrupts = false
noise_kind = &"phone"
noise_interval_sec = 3.0

[resource]
script = ExtResource("1_otune")
agenda_seed = 3
tasks = Array[ExtResource("2_task")]([SubResource("Resource_counter"), SubResource("Resource_restock"), SubResource("Resource_backroom"), SubResource("Resource_phone")])
