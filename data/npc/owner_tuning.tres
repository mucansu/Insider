back_door_autoclose_sec = 3.0
hearing_corner_px = 12.0
arm_reach_px = 48.0
counter_marker = &"ClerkSpot"
backroom_marker = &"BackroomSpot"
front_door_marker = &"FrontDoor"
look_min_sec = 0.5
look_max_sec = 1.0
question_speed = 110.0
question_stop = 64.0
question_wait_sec = 3.0
question_max_sec = 9.0
shout_radius = 320.0
shout_repeat_sec = 5.0
calm_after_sec = 30.0
cash_marker = &"BackroomCash"
serve_facing = Vector2(-1, 0)
register_open_sec = 2.0
