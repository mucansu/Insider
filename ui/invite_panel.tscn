[gd_scene format=3]

[ext_resource type="Script" path="res://ui/invite_panel.gd" id="1_invite"]

[node name="InvitePanel" type="VBoxContainer"]
script = ExtResource("1_invite")

[node name="Caption" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "MENU_INVITE_LABEL"

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="AddressLabel" type="Label" parent="Row"]
unique_name_in_owner = true
auto_translate_mode = 2
layout_mode = 2
size_flags_horizontal = 3

[node name="AddressButton" type="Button" parent="Row"]
unique_name_in_owner = true
visible = false
auto_translate_mode = 2
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
alignment = 0

[node name="CopyButton" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
text = "MENU_INVITE_COPY"

[node name="AddressList" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="NoteLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "MENU_INVITE_NO_TAILSCALE"
autowrap_mode = 3
