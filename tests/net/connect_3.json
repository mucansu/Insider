    {"ne": ["c2.peer_id", 1]},
    {"eq": ["host.is_host", true]},
    {"eq": ["c1.is_host", false]},
    {"eq": ["c2.is_host", false]},
    {"eq": ["*.host_lost", false]},
    {"eq": ["*.exit_reason", "quit_after"]},
    {"between": ["c1.ping_ms.1", 0, 400]},
    {"between": ["host.ping_ms.$c2", 0, 400]}
